# Copy this file to .env and fill in your own values. NEVER commit .env to git.

# --- Binance API credentials ---
# Create keys at binance.com/en/my/settings/api-management
# IMPORTANT: enable "Spot & Margin Trading" only. Do NOT enable withdrawals.
# Restrict the key to your server's IP address if possible.
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# --- Environment ---
# true  = paper-safe Binance Spot Testnet (fake money, real market data)
# false = LIVE trading with real funds. Only set this after testing thoroughly.
USE_TESTNET=true

# --- Symbol & strategy ---
SYMBOL=BTCUSDT
OBI_LEVELS=10
OBI_THRESHOLD=0.62
CVD_WINDOW_SECONDS=30
CVD_THRESHOLD=0.0

# --- Risk management (hard limits, enforced in code) ---
# Max % of quote balance to risk per single trade
MAX_POSITION_PCT=0.02
# Stop-loss / take-profit as a fraction of entry price
STOP_LOSS_PCT=0.006
TAKE_PROFIT_PCT=0.012
# Bot halts itself for the rest of the day once this % of starting balance is lost
MAX_DAILY_LOSS_PCT=0.03
# Minimum seconds between trades (prevents overtrading on noisy signals)
COOLDOWN_SECONDS=60
